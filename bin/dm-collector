#!/usr/bin/env python3
"""Data Monitor collector: exact totals + per-application usage.

Runs as a *user* systemd service.  No root, no firewall, no network access.

  * totals  : sampled from /proc/net/dev every TOTALS_EVERY seconds;
  * per-app : parsed from ``nethogs -t`` when nethogs is installed and the
              binary has been granted packet-capture capability.

If nethogs is missing or fails, totals keep working on their own.

Disk writes are kept small deliberately: connections are reused, per-app
deltas are accumulated in memory and flushed in one transaction every
APP_FLUSH seconds, and totals are sampled at 30 s (the deltas come from kernel
counters, so a longer interval loses nothing).
"""
from __future__ import annotations

import os
import shutil
import signal
import subprocess
import sys
import threading
import time
from typing import Dict, List

sys.path.insert(0, os.path.join(os.path.dirname(os.path.realpath(__file__)), "..", "lib"))

from counter import read_interfaces                               # noqa: E402
from storage import Storage                                     # noqa: E402
from nethogs_parse import parse_trace_line, TraceAccumulator    # noqa: E402

POLL = float(os.environ.get("DATA_MONITOR_POLL", "5"))            # nethogs -d
TOTALS_EVERY = float(os.environ.get("DATA_MONITOR_TOTALS", "30"))
APP_FLUSH = float(os.environ.get("DATA_MONITOR_FLUSH", "30"))
PRUNE_EVERY = 3600.0

# Set DATA_MONITOR_DEBUG=1 to log every row nethogs prints, with the delta it
# produces.  This is the only way to see nethogs' side of the accounting: the
# stored totals cannot tell a real transfer from a counter that keeps being
# re-counted, so a per-app figure that looks impossible is diagnosed here.
DEBUG = os.environ.get("DATA_MONITOR_DEBUG", "") == "1"
DEBUG_BIG = 1 << 20                    # log the raw line for deltas over 1 MiB

# nethogs -v 2 never forgets a process, so the labels we must remember to keep
# its counters honest also never go away.  Well before that becomes a memory
# problem (the collector is capped at MemoryMax=128M), recycle nethogs: the new
# instance starts every counter from zero and a fresh accumulator matches it, so
# nothing is added twice.  A few seconds of per-app detail is lost per recycle.
MAX_LABELS = 5000

_stop = threading.Event()


def log(msg: str) -> None:
    print(f"[data-monitor] {msg}", file=sys.stderr, flush=True)


def totals_worker(st: Storage) -> None:
    last_prune = 0.0
    while not _stop.is_set():
        try:
            st.sample_totals(read_interfaces())
            if time.time() - last_prune > PRUNE_EVERY:
                st.prune()
                last_prune = time.time()
        except Exception as exc:  # keep the loop alive no matter what
            log(f"totals error: {exc}")
        _stop.wait(TOTALS_EVERY)


def run_nethogs(st: Storage) -> None:
    nethogs = shutil.which("nethogs")
    if not nethogs:
        log("nethogs not installed yet - totals only")
        _stop.wait(60)
        return

    acc = TraceAccumulator()
    pending: Dict[str, List[int]] = {}
    last_flush = time.time()

    def flush() -> None:
        # Forget labels only once nethogs has stopped printing them.
        #
        # Do not evict on "the pid is gone": in trace mode nethogs 0.8.7 prunes
        # exited processes only in its rate view modes, and this monitor needs
        # -v 2 (total bytes).  A dead process therefore keeps being printed with
        # its final, frozen counter.  Dropping its baseline on pid death made
        # every flush treat that frozen counter as a new process and add all of
        # it again - one exited flatpak-update-worker was re-counted up to 27 MB
        # every 30 s and reached 3.9 GB on a day with 56 MB on the wire.
        evicted = acc.evict_stale()
        if DEBUG and evicted:
            log(f"evicted {evicted} stale nethogs label(s)")
        if pending:
            st.add_app_deltas(pending)
            pending.clear()

    cmd = [nethogs, "-t", "-d", str(max(1, int(POLL))), "-v", "2"]
    log("starting: " + " ".join(cmd))
    proc = subprocess.Popen(
        cmd, stdout=subprocess.PIPE, stderr=subprocess.DEVNULL, text=True, bufsize=1
    )
    try:
        assert proc.stdout is not None
        for line in proc.stdout:
            if _stop.is_set():
                break
            entry = parse_trace_line(line)
            if entry is None:
                continue
            # Key the delta on nethogs' own per-process label, never on the
            # display name: unrelated processes share a name ("brave",
            # "Unknown"), and their counters share no baseline.
            d_tx, d_rx = acc.feed(entry.key, entry.sent, entry.recv)
            if DEBUG:
                log(
                    f"row app={entry.app!r} pid={entry.pid} uid={entry.uid} "
                    f"sent={entry.sent} recv={entry.recv} "
                    f"d_tx={d_tx} d_rx={d_rx} key={entry.key!r}"
                )
                if d_rx > DEBUG_BIG or d_tx > DEBUG_BIG:
                    alive = os.path.exists(f"/proc/{entry.pid}") if entry.pid else None
                    log(f"BIG pid_alive={alive} raw={line.rstrip()!r}")
            if d_rx or d_tx:
                total = pending.setdefault(entry.app, [0, 0])
                total[0] += d_rx
                total[1] += d_tx
            if time.time() - last_flush >= APP_FLUSH:
                flush()
                last_flush = time.time()
            if acc.label_count() > MAX_LABELS:
                log(
                    f"{acc.label_count()} nethogs labels remembered; recycling "
                    "nethogs to reclaim them (trace mode never prunes)"
                )
                break
    finally:
        flush()                       # never lose the last partial window
        try:
            proc.terminate()
        except Exception:
            pass
        try:
            rc = proc.wait(timeout=5)
        except Exception:
            proc.kill()
            rc = -1
    log(f"nethogs exited (rc={rc})")
    if rc not in (0, -9, -15):
        # rc=1 here almost always means the binary no longer carries the
        # packet-capture capability (a package upgrade replaces the file and
        # the capability goes with it).  Say so out loud: the journal is the
        # only place this is visible, because the panel keeps showing the exact
        # total whether or not per-app data is being collected.
        log("per-application data is unavailable until this is fixed:")
        log(f"  getcap {nethogs}                     # expect cap_net_admin,cap_net_raw=eip")
        log("  sudo bash scripts/install-system.sh  # re-grant it")


def main() -> int:
    st = Storage()
    threading.Thread(target=totals_worker, args=(st,), daemon=True).start()

    def handle(_signum, _frame):
        _stop.set()

    signal.signal(signal.SIGTERM, handle)
    signal.signal(signal.SIGINT, handle)

    while not _stop.is_set():
        started = time.time()
        try:
            run_nethogs(st)
        except Exception as exc:
            log(f"collector error: {exc}")
        ran = time.time() - started
        if not _stop.is_set():
            # If nethogs died straight away (e.g. capability not granted yet),
            # back off so we never spam; otherwise just restart promptly.
            _stop.wait(60 if ran < 5 else 5)
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
